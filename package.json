{
  "name": "wordpool",
  "version": "0.1.0",
  "private": true,
  "description": "Word Pool — a letter-extraction puzzle game. Pull every letter out of the pool by drawing its own shape.",
  "type": "module",
  "scripts": {
    "start": "npx http-server web -p 8080 -c-1",
    "test": "node --test tests/engine.test.mjs tests/economy.test.mjs tests/levels.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build:levels": "node tools/build-levels.mjs 200",
    "build:single": "node tools/build-single.mjs",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
